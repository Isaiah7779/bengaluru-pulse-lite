# Root .env for docker compose (copy to .env; never commit the real file).

# --- local development (docker-compose.yml alone) ---------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:3000
POSTGRES_PASSWORD=pulse_dev_only
FRONTEND_PORT=8080

# --- production overlay (docker-compose.prod.yml) ---------------------------
# Public DNS name pointing at the server; Caddy issues HTTPS for it.
PUBLIC_HOST=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional. Without it, routing works on OSRM free-flow times only.
TOMTOM_API_KEY=

# Optional: non-default OSRM graph locations (see infrastructure/osrm/prepare_graphs.sh)
# OSRM_CAR_DIR=./data/osm
# OSRM_FOOT_DIR=./data/osrm-foot
# OSRM_BICYCLE_DIR=./data/osrm-bicycle
