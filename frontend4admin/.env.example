# Development uses the API on localhost:8000. For a standalone deployment, use /api.
PORT=3001
REACT_APP_API_BASE_URL=http://localhost:8000

# Firebase browser identifiers are public configuration, never server credentials.
# Leave unset when using the backend's legacy sign-in (if enabled).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=
