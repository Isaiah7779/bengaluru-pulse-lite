FROM node:22-alpine AS build

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG REACT_APP_API_BASE_URL=/api
ENV REACT_APP_API_BASE_URL=$REACT_APP_API_BASE_URL
ARG REACT_APP_FIREBASE_API_KEY=
ARG REACT_APP_FIREBASE_AUTH_DOMAIN=
ARG REACT_APP_FIREBASE_PROJECT_ID=
ARG REACT_APP_FIREBASE_APP_ID=
ENV REACT_APP_FIREBASE_API_KEY=$REACT_APP_FIREBASE_API_KEY     REACT_APP_FIREBASE_AUTH_DOMAIN=$REACT_APP_FIREBASE_AUTH_DOMAIN     REACT_APP_FIREBASE_PROJECT_ID=$REACT_APP_FIREBASE_PROJECT_ID     REACT_APP_FIREBASE_APP_ID=$REACT_APP_FIREBASE_APP_ID
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY infrastructure/nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
