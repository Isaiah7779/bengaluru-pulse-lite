# Optional. Leave unset: production builds use same-origin /api (served by nginx),
# `npm start` uses http://localhost:8000. Set only for a separate API host, e.g.
# REACT_APP_API_BASE_URL=https://api.example.org
REACT_APP_API_BASE_URL=

# Firebase web-app config (public identifiers, not secrets). Leave empty to use the
# built-in sign-in. For `npm start` put real values in .env.local (git-ignored).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=
# Local Emulator Suite only (cd firebase && npm run emulators): true + any demo values.
REACT_APP_FIREBASE_EMULATOR=
