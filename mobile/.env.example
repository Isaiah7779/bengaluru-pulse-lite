# Optional build-time backend URL (not a secret). Use only a STABLE HTTPS address,
# e.g. EXPO_PUBLIC_API_BASE_URL=https://pulse.example.org/api
# Leave unset to: (1) use the server saved on the device (Account -> Server), or
# (2) during `npx expo start`, use the laptop's LAN address automatically.
# Never put a temporary tunnel URL here for a distributed build.
EXPO_PUBLIC_API_BASE_URL=

# Firebase (same project as the web app; public identifiers, not secrets).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# OAuth client ID of type "Web application" that Firebase created for Google sign-in
# (Google Cloud console -> APIs & Services -> Credentials). Needed for native Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Dev only: LAN IP of the machine running the Firebase emulators.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
# iOS builds only (not read at runtime): reversed iOS OAuth client ID,
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.<id>
