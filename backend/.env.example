# Backend settings (copy to backend/.env; never commit the real file).
# Every variable is optional for local development unless marked.

ENVIRONMENT=development            # development | test | production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
LOG_LEVEL=INFO

# Database: PostgreSQL/PostGIS (use 127.0.0.1, not localhost, on Windows).
# Without it, a local SQLite file is used (dev only; no PostGIS features).
DATABASE_URL=postgresql://pulse:pulse_dev_only@127.0.0.1:5433/pulse
DB_AUTO_CREATE=false               # true = create tables without Alembic (tests/dev only)

# Routing servers (one OSRM per profile; a missing one disables that mode)
OSRM_URL=http://localhost:5000          # car.lua
OSRM_FOOT_URL=http://localhost:5001     # foot.lua
OSRM_BICYCLE_URL=http://localhost:5002  # bicycle.lua

# Auth. Required (>=32 chars) when ENVIRONMENT=production.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60

# Traffic (optional): https://developer.tomtom.com — free tier 2,500 non-tile requests/day
TOMTOM_API_KEY=
TOMTOM_DAILY_BUDGET=2000
TOMTOM_ROUTE_EVAL_MAX=5

# Collector intervals (minutes)
COLLECTOR_FLOW_INTERVAL_MINUTES=30
COLLECTOR_WEATHER_INTERVAL_MINUTES=30
COLLECTOR_INCIDENT_INTERVAL_MINUTES=60
OBSERVATION_STALE_MINUTES=90

# Retention (days)
RETENTION_OBSERVATION_DAYS=730
RETENTION_TRIP_DAYS=180
RETENTION_SUBMISSION_TRACE_DAYS=90

# Geocoding fallback (Photon by komoot); set false to use only the local gazetteer
GEOCODE_FALLBACK_ENABLED=true

# Legacy V1 model artifacts
TRAFFIC_MODEL_PATH=traffic_model_tuned.pkl
TRAFFIC_DATASET_PATH=Banglore_traffic_Dataset.csv
